{
  "expo": {
    "name": "Narrows",
    "slug": "narrows-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "site.narrows.app",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:narrows.site"],
      "infoPlist": {
        "NSFaceIDUsageDescription": "Narrows uses Face ID to sign you in quickly and securely.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["whatsapp"]
      },
      "supportsTablet": false
    },
    "android": {
      "package": "site.narrows.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "747b40d4-7c6e-416a-9be2-e4cd125daea7"
      }
    },
    "plugins": [
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.68112871311-r5e7q37ons8qc4ftdakj5d9tle3ngou3"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              },
              {
                "name": "AppCheckCore",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Narrows uses your location in the background to track your trip's distance and time while the app is closed.",
          "locationWhenInUsePermission": "Narrows uses your location to show your position on the water, drop catch pins, and track trips.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Narrows saves photos and videos from posts to your camera roll.",
          "photosPermission": "Narrows accesses your photos so you can share them in posts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Narrows uses your photo library so you can attach photos and videos to your posts.",
          "cameraPermission": "Narrows uses your camera so you can take photos and videos of your catches and trips.",
          "microphonePermission": "Narrows uses your microphone to record audio when you capture a video."
        }
      ]
    ]
  }
}
